PROJECT_NAME="SmartPYQ"
API_V1_STR="/api/v1"

# Database Configuration
DATABASE_URL="postgresql+psycopg://postgres:postgrespassword@localhost:5432/smartpyq_db"

# Embedding Model Configuration
EMBEDDING_MODEL_NAME="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DIMENSION=384

# Tesseract Configuration (Modify if installed in non-standard location)
# Typical Windows path: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=""

# Upload directory
UPLOAD_DIR="data/uploads"
